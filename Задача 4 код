#include <iostream>
#include <cmath>
#include <string>

using namespace std;

/**
 * @brief Ввод числа с опциональной проверкой на значение > minValue
 * @param prompt – текст запроса
 * @param minValue – минимально допустимое значение
 * @param enforceMin – включить проверку value > minValue
 * @return введённое число
 */
double inputNumber(const string& prompt, double minValue, bool enforceMin);

/**
 * @brief Вычисляет y(x) = sin(ln(x)) - cos(ln(x)) + 2·ln(x)
 * @param x – аргумент функции
 * @return результат вычисления
 */
double calculateY(double x);

/**
 * @brief Цикл вычисления y(x) от x_start до x_end с шагом delta с проверкой ln(x)
 * @param x_start – начальное значение
 * @param x_end – конечное значение
 * @param delta – шаг изменения x
 */
void computeAndPrint(double x_start, double x_end, double delta);

/**
 * @brief Точка входа в программу
 * @return код завершения (0 – успех)
 */
int main()
{
    setlocale(LC_ALL, "Russian");
    double x_start = inputNumber("Введите начальное значение x: ", 0.0, false);
    double x_end = inputNumber("Введите конечное значение x: ", x_start, true);
    double delta = inputNumber("Введите шаг delta: ", 0.0, true);
    computeAndPrint(x_start, x_end, delta);
    return 0;
}

double inputNumber(const string& prompt, double minValue, bool enforceMin)
{
    double value;
    cout << prompt;
    while (!(cin >> value) || (enforceMin && value <= minValue)) {
        if (cin.fail()) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Ошибка ввода.\n";
        }
        else {
            cout << "Ошибка: значение должно быть больше " << minValue << ".\n";
        }
        cout << prompt;
    }
    return value;
}

double calculateY(double x)
{
    return sin(log(x)) - cos(log(x)) + 2 * log(x);
}

void computeAndPrint(double x_start, double x_end, double delta)
{
    cout << "\nРезультаты:\n";
    for (double x = x_start; x <= x_end; x += delta) {
        if (x <= 0.0) {
            cerr << "Пропущено x=" << x << ": вне области определения ln(x)\n";
            continue;
        }
        cout << "y(" << x << ") = " << calculateY(x) << endl;
    }
}
