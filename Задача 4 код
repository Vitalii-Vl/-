#include <iostream>
#include <math.h>
using namespace std;

/**
@brief - Функция для вычисления Y по заданному уравнению
* @param x - значение переменной x
* @return - возвращает рассчитанное значение
*/
double y(double x)
{
    return sin(log(x)) - cos(log(x)) + 2 * log(x);
}

int main()
{
    const double delta = 0.2; // дельта x - шаг 
    for (double x = 1.0; x <= 3.2; x += delta)
    {
        cout << "Значение функции y(x) при " << x << " равно " << y(x) << endl;
    }
    return 0;
}
